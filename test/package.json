    "@agent-router/backend-services": "workspace:*",
    "@agent-router/background": "workspace:*",
    "@agent-router/provider-clients": "workspace:*",
    "@agent-router/shared": "workspace:*",
    "@rexezuge/errors": "1.9.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
