{
  "name": "@agent-router/test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//": "A workspace project so `pnpm -r typecheck` and `pnpm run lint` reach this directory, and so pnpm links the bare specifiers its files import.",
  "scripts": {
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit"
