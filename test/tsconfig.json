{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["vitest/globals", "node", "@cloudflare/vitest-pool-workers/types"],
    "paths": {
      "@/*": ["../apps/api/src/*"],
      "@agent-router/background": ["../apps/background/src"],
      "@agent-router/background/*": ["../apps/background/src/*"],
      "@agent-router/backend-data": ["../packages/backend-data/src"],
      "@agent-router/backend-data/*": ["../packages/backend-data/src/*"],
      "@agent-router/backend-runtime": ["../packages/backend-runtime/src"],
      "@agent-router/backend-runtime/*": ["../packages/backend-runtime/src/*"],
      "@agent-router/backend-services": ["../packages/backend-services/src"],
      "@agent-router/backend-services/*": ["../packages/backend-services/src/*"],
      "@agent-router/provider-clients": ["../packages/provider-clients/src"],
      "@agent-router/provider-clients/*": ["../packages/provider-clients/src/*"],
      "@agent-router/shared": ["../packages/shared/src"],
      "@agent-router/shared/*": ["../packages/shared/src/*"]
    }
  },
  "include": ["**/*.ts", "../worker-configuration.d.ts", "../packages/backend-runtime/src/env.d.ts", "../apps/api/src/types.d.ts"]
}
